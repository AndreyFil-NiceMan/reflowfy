# syntax=docker/dockerfile:1.7
# =============================================================================
# Reflowfy base image (MAINTAINER ONLY)
#
# Bakes reflowfy + all of its dependencies into a virtualenv at /opt/venv on top
# of a Python base image, and ships uv so the service images can `uv sync` the
# user's project into that same venv. End users never build this — they consume
# the published image via the REFLOWFY_BASE_IMAGE build arg in their
# api/reflow-manager/worker Dockerfiles.
#
# Build & push with: ./scripts/build_base_image.sh   (BuildKit required)
# =============================================================================
ARG PYTHON_IMAGE=python:3.11-slim
# Same uv as CI (.github/workflows/tests.yml).
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE}

COPY --from=uv /uv /uvx /usr/local/bin/

# VIRTUAL_ENV / UV_PROJECT_ENVIRONMENT: every `uv pip` / `uv sync`, here and in
# the service images, targets /opt/venv. UV_COMPILE_BYTECODE: precompile .pyc at
# install time (faster cold start, nothing written at runtime). UV_LINK_MODE=copy:
# the uv cache is a BuildKit cache mount on another filesystem, so hardlinks fail.
ENV VIRTUAL_ENV=/opt/venv \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

RUN uv venv /opt/venv --python /usr/local/bin/python3

# Install reflowfy together with all its dependencies. Blank REFLOWFY_VERSION
# installs the latest published release. (scripts/run_e2e_tests.sh rewrites
# this line to install a local wheel — keep its shape.)
ARG REFLOWFY_VERSION=
RUN --mount=type=cache,target=/root/.cache/uv uv pip install "reflowfy${REFLOWFY_VERSION:+==$REFLOWFY_VERSION}"

# Non-root runtime user. GID 0 + group-writable /app is the OpenShift convention:
# OpenShift runs the container as an arbitrary UID that is always in group 0, and
# plain Kubernetes with runAsNonRoot (the charts' default) needs a numeric non-root
# USER. The image stays root here so service builds can `uv sync`; the service
# Dockerfiles switch to this user last.
RUN useradd --uid 10001 --gid 0 --no-create-home --home-dir /app --shell /usr/sbin/nologin reflowfy \
 && mkdir -p /app \
 && chown 10001:0 /app \
 && chmod g=u /app

WORKDIR /app

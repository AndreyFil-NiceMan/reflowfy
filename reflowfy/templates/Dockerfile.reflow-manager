# syntax=docker/dockerfile:1.7
# Builds the Reflowfy ReflowManager image on top of the published reflowfy base image.
# The base image already provides reflowfy + all of its dependencies in /opt/venv,
# plus uv. BuildKit is required (the default for docker build / compose v2).
ARG REFLOWFY_BASE_IMAGE=reflowfy-base:latest
FROM ${REFLOWFY_BASE_IMAGE}

WORKDIR /app

# Install the project's dependencies exactly as locked in uv.lock, into the base
# image's venv. This layer comes before the source so it is rebuilt only when
# pyproject.toml / uv.lock change, not on every pipeline edit.
#   --locked                       fail if uv.lock is stale (run `uv lock`), never re-resolve
#   --no-install-project           the project is your code under src/, not a package
#   --no-install-package reflowfy  keep the base image's reflowfy
#   --inexact                      keep the base image's packages that are not in uv.lock
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project --no-install-package reflowfy --inexact

# Copy user pipelines and components
COPY src/ src/

ENV PYTHONPATH=/app/src:/app \
    PIPELINE_MODULE=pipelines

EXPOSE 8001
# Non-root user created by the base image (UID 10001, GID 0).
USER 10001

CMD ["python", "-m", "reflowfy.reflow_manager.app"]

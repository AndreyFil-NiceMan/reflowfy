{
  "index_patterns": ["reflowfy-logs-*"],
  "priority": 200,
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "text" },
        "error.message": { "type": "text" },
        "error.stack_trace": { "type": "text", "index": false },
        "rate_limit": { "type": "float" },
        "retry_in_s": { "type": "float" },
        "duration_ms": { "type": "long" },
        "records_in": { "type": "long" },
        "records_out": { "type": "long" }
      }
    }
  }
}
